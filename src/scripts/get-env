#!/usr/bin/env bash
set -euo pipefail

if ! command -v az >/dev/null 2>&1; then
  echo "Azure CLI (az) is required but was not found."
  echo "Install Azure CLI and re-run this script."
  exit 1
fi

# Prompt for Azure login when there is no active session.
if ! az account show >/dev/null 2>&1; then
  echo "You need to sign in to Azure to retrieve Azure OpenAI credentials."
  read -r -p "Press Enter to continue with 'az login --use-device-code'... "
  az login --use-device-code >/dev/null
fi

if ! az account show >/dev/null 2>&1; then
  echo "Azure login failed or was cancelled."
  exit 1
fi

# Use the lab resource group directly.
selected_rg="ResourceGroup1"

rg_info=$(az group show --name "$selected_rg" --query "location" -o tsv 2>/dev/null | tr -d '\r') || {
  echo "Resource group '$selected_rg' was not found in the current subscription."
  echo "If it is in another subscription, run: az account set --subscription <name-or-id>"
  exit 1
}
selected_location="$rg_info"

echo "Using resource group: $selected_rg ($selected_location)"

# Find AIServices / OpenAI accounts in the selected resource group using az rest
# (avoids CLI cognitiveservices module deserialization bugs)
# tr -d '\r' strips Windows carriage returns from az output
sub_id=$(az account show --query id -o tsv | tr -d '\r')

mapfile -t ai_accounts < <(az rest --method get \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts?api-version=2024-10-01" \
  --query "value[?kind=='AIServices' || kind=='OpenAI'].name" -o tsv | tr -d '\r')

if [[ ${#ai_accounts[@]} -eq 0 ]]; then
  echo "No AIServices or OpenAI accounts found in resource group '$selected_rg'."
  exit 1
fi

selected_name=""

if [[ ${#ai_accounts[@]} -eq 1 ]]; then
  selected_name="${ai_accounts[0]}"
else
  echo "Multiple AI accounts found. Select one:"
  for i in "${!ai_accounts[@]}"; do
    printf "  %d) %s\n" "$((i + 1))" "${ai_accounts[$i]}"
  done

  while true; do
    read -r -p "Enter a number [1-${#ai_accounts[@]}]: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#ai_accounts[@]} )); then
      selected_name="${ai_accounts[$((choice - 1))]}"
      break
    fi
    echo "Invalid selection. Try again."
  done
fi

# Get the base endpoint (e.g., https://dv-wus2.services.ai.azure.com/)
base_endpoint=$(az rest --method get \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts/$selected_name?api-version=2024-10-01" \
  --query properties.endpoint -o tsv | tr -d '\r')

# Use the account name as the project identifier
project_name="$selected_name"

echo "Found project: $project_name"

# Build project endpoint: https://<host>.services.ai.azure.com/api/projects/<project-name>
endpoint="${base_endpoint%/}/api/projects/$project_name"

# Get API key
api_key=$(az rest --method post \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts/$selected_name/listKeys?api-version=2024-10-01" \
  --query key1 -o tsv | tr -d '\r')

if [[ -z "$endpoint" || -z "$api_key" ]]; then
  echo "Failed to retrieve endpoint or API key from account '$selected_name'."
  exit 1
fi

# Write credentials to .env file at the repo root.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
ENV_FILE="$REPO_ROOT/.env"

cat > "$ENV_FILE" <<EOF
FOUNDRY_PROJECT_ENDPOINT=$endpoint
API_KEY=$api_key
EOF

echo
echo "AI Foundry project credentials retrieved for: $project_name (account: $selected_name, rg: $selected_rg)"
echo "Written to $ENV_FILE"

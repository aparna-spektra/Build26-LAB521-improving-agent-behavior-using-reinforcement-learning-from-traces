#!/usr/bin/env bash
set -euo pipefail

# Check Azure CLI is installed
if ! command -v az >/dev/null 2>&1; then
  echo "Azure CLI (az) is required but was not found."
  echo "Install Azure CLI and re-run this script."
  exit 1
fi

# Check if logged in
if ! az account show >/dev/null 2>&1; then
  echo "You need to sign in to Azure to retrieve Azure OpenAI credentials."
  echo "Running: az login --use-device-code"
  az login --use-device-code >/dev/null
fi

if ! az account show >/dev/null 2>&1; then
  echo "Azure login failed or was cancelled."
  exit 1
fi

# Check resource group
selected_rg="ResourceGroup1"
selected_location=$(az group show --name "$selected_rg" --query "location" -o tsv 2>/dev/null) || {
  echo "Resource group '$selected_rg' was not found in the current subscription."
  echo "If it is in another subscription, run: az account set --subscription <name-or-id>"
  exit 1
}
echo "Using resource group: $selected_rg ($selected_location)"

# Get subscription ID
sub_id=$(az account show --query id -o tsv)

# Find AIServices / OpenAI account in the resource group using az rest
selected_name=$(az rest --method get \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts?api-version=2024-10-01" \
  --query "value[?kind=='AIServices' || kind=='OpenAI'].name | [0]" -o tsv)

if [[ -z "$selected_name" ]]; then
  echo "No AIServices or OpenAI accounts found in resource group '$selected_rg'."
  exit 1
fi
echo "Found AI account: $selected_name"

# Get endpoint
base_endpoint=$(az rest --method get \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts/$selected_name?api-version=2024-10-01" \
  --query "properties.endpoint" -o tsv)
endpoint="${base_endpoint%/}/openai/v1"

# Get API key
api_key=$(az rest --method post \
  --url "https://management.azure.com/subscriptions/$sub_id/resourceGroups/$selected_rg/providers/Microsoft.CognitiveServices/accounts/$selected_name/listKeys?api-version=2024-10-01" \
  --query "key1" -o tsv)

if [[ -z "$endpoint" || -z "$api_key" ]]; then
  echo "Failed to retrieve endpoint or API key from account '$selected_name'."
  exit 1
fi

# Find first Foundry project in the resource group (if available)
foundry_project_resource_name=$(az resource list \
  --resource-group "$selected_rg" \
  --resource-type "Microsoft.CognitiveServices/accounts/projects" \
  --query "[0].name" -o tsv 2>/dev/null || true)

foundry_project_endpoint=""
if [[ -n "$foundry_project_resource_name" ]]; then
  # Nested resource names are typically returned as "<accountName>/<projectName>"
  if [[ "$foundry_project_resource_name" == */* ]]; then
    foundry_account_name="${foundry_project_resource_name%%/*}"
    foundry_project_name="${foundry_project_resource_name##*/}"
  else
    foundry_account_name="$selected_name"
    foundry_project_name="$foundry_project_resource_name"
  fi
  foundry_project_endpoint="https://${foundry_account_name}.services.ai.azure.com/api/projects/${foundry_project_name}"
fi

# Write .env file in the repo root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$REPO_ROOT/.env"

cat > "$ENV_FILE" <<EOF
# Please ensure you have "openai/v1" at the end of the project endpoint
AZURE_OPENAI_ENDPOINT=$endpoint
AZURE_OPENAI_API_KEY=$api_key
FOUNDRY_PROJECT_ENDPOINT=$foundry_project_endpoint
EOF

echo
echo "Azure OpenAI credentials retrieved for: $selected_name (rg: $selected_rg)"
if [[ -n "$foundry_project_endpoint" ]]; then
  echo "Foundry project endpoint retrieved"
else
  echo "No Foundry project found in resource group '$selected_rg'."
  echo "FOUNDRY_PROJECT_ENDPOINT was written as an empty value."
fi
echo "Written to $ENV_FILE"

# Azure AI Foundry Project Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# Project URL (format: https://{account}.services.ai.azure.com/api/projects/{project})
PROJECT_ENDPOINT=https://ai-account-44mf5lkxqssxm.services.ai.azure.com/api/projects/ai-project-omi-build26-azd-env

# Tool Function App URL (required for RFT training)
# Format: https://your-function-app.azurewebsites.net/api
# This is your deployed zava-next-tools Function App from Phase 1
TOOL_URL=https://your-function-app.azurewebsites.net/api

# Optional: Agent API Key (if using direct API calls instead of DefaultAzureCredential)
# AGENT_API_KEY=your-api-key-here
